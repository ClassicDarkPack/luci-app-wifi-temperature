#!/bin/sh
# Return temperature readings in millidegrees Celsius as JSON.
# Only the fixed, known hardware sensor paths are accessed.

radio24=null
radio5=null
device=null
max=-40001

for hw in /sys/class/hwmon/hwmon*; do
    [ -r "$hw/name" ] && [ -r "$hw/temp1_input" ] || continue

    IFS= read -r sensor < "$hw/name" || continue
    case "$sensor" in
        ath10k_hwmon|ath11k_hwmon) ;;
        *) continue ;;
    esac

    IFS= read -r value < "$hw/temp1_input" || continue
    case "$value" in
        ''|*[!0-9-]*) continue ;;
    esac
    [ "$value" -ge -40000 ] 2>/dev/null || continue
    [ "$value" -le 150000 ] 2>/dev/null || continue

    if [ "$value" -gt "$max" ]; then
        max=$value
        device=$value
    fi

    path=$(readlink -f "$hw/device" 2>/dev/null)
    case "$path" in
        */a000000.wifi|*/a000000.wifi/*) radio24=$value ;;
        */a800000.wifi|*/a800000.wifi/*) radio5=$value ;;
    esac
done

printf '{"device":%s,"radio24":%s,"radio5":%s}\n' "$device" "$radio24" "$radio5"
